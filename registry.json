{
    "$schema":  "https://ui.shadcn.com/schema/registry.json",
    "name":  "kit-ui",
    "homepage":  "https://github.com/Cambar-Solutions/kit-ui",
    "items":  [
                  {
                      "name":  "kit-tokens",
                      "type":  "registry:theme",
                      "title":  "kit-ui tokens",
                      "description":  "Variables kit-ui needs that a shadcn theme does not define: success, warning, destructive-foreground, control height, motion duration and section spacing. Colors, type and radius still come from the project theme.",
                      "cssVars":  {
                                      "light":  {
                                                    "success":  "oklch(0.45 0.13 150)",
                                                    "warning":  "oklch(0.45 0.12 70)",
                                                    "destructive-foreground":  "oklch(0.99 0 0)"
                                                },
                                      "dark":  {
                                                   "success":  "oklch(0.75 0.14 150)",
                                                   "warning":  "oklch(0.8 0.13 80)",
                                                   "destructive-foreground":  "oklch(0.17 0 0)"
                                               }
                                  },
                      "css":  {
                                  "@layer base":  {
                                                      ":root":  {
                                                                    "--control-h":  "2.75rem",
                                                                    "--motion":  "150ms",
                                                                    "--space-section":  "1.5rem"
                                                                }
                                                  },
                                  "@media (prefers-reduced-motion: reduce)":  {
                                                                                  ":root":  {
                                                                                                "--motion":  "0ms"
                                                                                            }
                                                                              },
                                  "@keyframes kit-shimmer":  {
                                                                 "0%":  {
                                                                            "background-position":  "100% 0"
                                                                        },
                                                                 "100%":  {
                                                                              "background-position":  "-100% 0"
                                                                          }
                                                             }
                              },
                      "categories":  [
                                         "theme"
                                     ]
                  },
